"""
search.py — Web search tool powered by Serper API.

Used by the agent to research:
  - Company background, mission, recent news
  - Engineering culture, tech stack
  - The specific role / team context

Free tier: 2,500 queries — https://serper.dev/
"""

import os
import httpx
from dotenv import load_dotenv

load_dotenv()

SERPER_API_KEY = os.getenv("SERPER_API_KEY")
SERPER_ENDPOINT = "https://google.serper.dev/search"

_MAX_RESULTS = 5
_MAX_SNIPPET_LEN = 400


def web_search(query: str, num_results: int = _MAX_RESULTS) -> dict:
    """
    Run a web search and return summarised results.

    Returns:
        {"success": True,  "results": [...], "query": query}
      | {"success": False, "error": "...",   "query": query}

    Each result:
        {"title": str, "url": str, "snippet": str}
    """
    if not SERPER_API_KEY:
        return {
            "success": False,
            "error": "SERPER_API_KEY not set. Add it to your .env file.",
            "query": query,
        }

    headers = {
        "X-API-KEY": SERPER_API_KEY,
        "Content-Type": "application/json",
    }
    payload = {
        "q": query,
        "num": min(num_results, 10),
    }

    try:
        with httpx.Client(timeout=15) as client:
            response = client.post(SERPER_ENDPOINT, headers=headers, json=payload)
            response.raise_for_status()
    except httpx.HTTPStatusError as e:
        return {"success": False, "error": f"Serper API HTTP {e.response.status_code}", "query": query}
    except httpx.RequestError as e:
        return {"success": False, "error": f"Network error: {e}", "query": query}

    data = response.json()
    raw_results = data.get("organic", [])

    results = []
    for item in raw_results:
        snippet = item.get("snippet", "").strip()
        if len(snippet) > _MAX_SNIPPET_LEN:
            snippet = snippet[:_MAX_SNIPPET_LEN] + "..."
        results.append({
            "title": item.get("title", ""),
            "url": item.get("link", ""),
            "snippet": snippet,
        })

    return {"success": True, "results": results, "query": query}
